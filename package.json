{
  "name": "aurora-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aurora desktop workspace prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
