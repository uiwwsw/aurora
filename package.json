{
  "name": "aurora-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Aurora — one conversation, assisted organization, and model routing previews.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node .github/scripts/apply-ai-notice.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/desktop-smoke.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "npm run build && npm run icons && node scripts/package.mjs",
    "package:mac": "npm run package -- --mac",
    "package:win": "npm run package -- --win --x64",
    "test:package": "node scripts/package-smoke.mjs",
    "build:web": "npm run build && node scripts/build-web.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiwwsw/aurora.git"
  },
  "bugs": {
    "url": "https://github.com/uiwwsw/aurora/issues"
  },
  "homepage": "https://github.com/uiwwsw/aurora#readme",
  "author": "uiwwsw"
}
